# ==============================================================================
# 🌐 ZAITX MEDIA — Environment Configuration Template (مثال متغيرات البيئة)
# ==============================================================================
# Arabic: استخدم هذا الملف كنموذج لإعداد متغيرات البيئة في النسخ الجديدة بدون بيانات سريّة.
# English: Copy this file to `.env` or `.env.local` for setting up clean new environments.
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. AUTHENTICATION & SECURITY SECRETS | مفاتيح الأمان والتوثيق
# ------------------------------------------------------------------------------
# EN: Secret key for signing authentication sessions (Min 32 characters).
# AR: المفتاح السري المخصص لتشفير جلسات التوثيق والتسجيل (32 حرفاً على الأقل).
BETTER_AUTH_SECRET=your_32_character_random_auth_secret_here

# EN: Secret key for verifying admin user sessions (Min 32 characters).
# AR: مفتاح التشفير الخاص بجلسات دخول مدير النظام (الأدمن).
ADMIN_SESSION_SECRET=your_32_character_random_admin_secret_here

# EN: Default admin login credentials for initial deployment.
# AR: البريد الإلكتروني وكلمة المرور الافتراضية لحساب الأدمن الرئيسي عند التشغيل الأول.
ADMIN_EMAIL=admin@yourdomain.com
ADMIN_PASSWORD=your_secure_admin_password_123

# ------------------------------------------------------------------------------
# 2. GOOGLE OAUTH CONFIGURATION | تسجيل الدخول عبر جوجل
# ------------------------------------------------------------------------------
# EN: Google OAuth Client ID and Secret obtained from Google Cloud Console.
# AR: معرف وقيمة المفتاح السري المكتسبين من منصة Google Cloud Console لتشغيل الدخول بجوجل.
GOOGLE_CLIENT_ID=your_google_client_id_here.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=your_google_client_secret_here

# ------------------------------------------------------------------------------
# 3. EMAIL DELIVERY SERVICES (BREVO / RESEND) | خدمات إرسال البريد الإلكتروني
# ------------------------------------------------------------------------------
# EN: API keys for transactional emails (verification codes, notifications).
# AR: مفاتيح الربط البرمجي لإرسال رسائل التفعيل وإشعارات البريد الإلكتروني عبر Brevo أو Resend.
BREVO_API_KEY=xkeysib-your_brevo_api_key_here
RESEND_API_KEY=re_your_resend_api_key_here

# EN: Sender details displayed on outgoing emails.
# AR: بيانات الاسم والبريد التي تظهر للمستلم عند وصول الرسائل.
BREVO_SENDER_NAME="ZAITX MEDIA"
BREVO_SENDER_EMAIL=auth@yourdomain.com
BREVO_REPLY_TO_EMAIL=support@yourdomain.com

# ------------------------------------------------------------------------------
# 4. SITE URLS & DOMAIN ROUTING | روابط المواقع والدومينات
# ------------------------------------------------------------------------------
# EN: Public URL of the web application.
# AR: الرابط الرسمي المعلن للموقع الإلكتروني.
NEXT_PUBLIC_SITE_URL=https://yourdomain.com
SITE_URL=https://yourdomain.com

# EN: Authentication endpoint URLs.
# AR: روابط محرك التوثيق والتسجيل للعملاء.
NEXT_PUBLIC_AUTH_URL=https://auth.yourdomain.com/v3
AUTH_BASE_URL=https://auth.yourdomain.com
AUTH_BASE_PATH=/v3

# ------------------------------------------------------------------------------
# 5. SECURITY & CAPTCHA (CLOUDFLARE TURNSTILE) | حماية الكابتشا والأمان
# ------------------------------------------------------------------------------
# EN: Cloudflare Turnstile bot protection site key.
# AR: مفتاح الموقع لمنع البوتات وحماية النموذج عبر Cloudflare Turnstile.
NEXT_PUBLIC_TURNSTILE_SITE_KEY=your_turnstile_site_key_here

# ------------------------------------------------------------------------------
# 6. PUSH NOTIFICATIONS (ONESIGNAL) | نظام الإشعارات الفورية
# ------------------------------------------------------------------------------
# EN: OneSignal Application ID & REST API Key for desktop and mobile notifications.
# AR: معرف وتوكين تطبيق OneSignal لتشغيل الإشعارات الفورية للمتصفح والأجهزة.
NEXT_PUBLIC_ONESIGNAL_APP_ID=your_onesignal_app_id_here
ONESIGNAL_APP_ID=your_onesignal_app_id_here
ONESIGNAL_REST_API_KEY=your_onesignal_rest_api_key_here

# ------------------------------------------------------------------------------
# 7. SMS GATEWAY & PROVIDER WEBHOOKS | بوابة الرسائل والـ Webhooks
# ------------------------------------------------------------------------------
# EN: HMAC Secret key for verifying incoming SMS gateway POST webhooks from Android app.
# AR: مفتاح الـ HMAC لتأكيد صحة الرسائل القادمة تلقائياً من تطبيق أندرويد الهاتفي لربط الإيداعات.
SMS_WEBHOOK_HMAC_SECRET=your_sms_gateway_hmac_secret_here

# EN: HMAC Secret key for verifying third-party provider status callbacks.
# AR: مفتاح الـ HMAC المخصص للتحقق من تحديثات حالة الطلبات القادمة من المزودين الخارجيين.
PROVIDER_WEBHOOK_HMAC_SECRET=your_provider_webhook_hmac_secret_here

# EN: Secret key for authorizing automated CRON maintenance jobs.
# AR: المفتاح السري لتشغيل وسمح بالمهام المجدولة والتنظيف الدوري (Cron Jobs).
CRON_SECRET=your_cron_job_secret_here
