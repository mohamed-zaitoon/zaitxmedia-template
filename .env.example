# ============================================================================
# ZaitXMedia Open-Source Template Environment Configuration Example
# Replace all placeholder values with your actual credentials in .env.local
# ============================================================================

NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=pk_test_EXAMPLE_CLERK_PUBLISHABLE_KEY
CLERK_SECRET_KEY=sk_test_EXAMPLE_CLERK_SECRET_KEY

NEXT_PUBLIC_FIREBASE_API_KEY=EXAMPLE_FIREBASE_API_KEY
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=example-project.firebaseapp.com
NEXT_PUBLIC_FIREBASE_PROJECT_ID=example-project-id
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET=example-project.appspot.com
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=000000000000
NEXT_PUBLIC_FIREBASE_APP_ID=1:000000000000:web:exampleappid

FIREBASE_ADMIN_PROJECT_ID=example-project-id
FIREBASE_ADMIN_CLIENT_EMAIL=firebase-adminsdk@example-project.iam.gserviceaccount.com
FIREBASE_ADMIN_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\nEXAMPLE_PRIVATE_KEY\n-----END PRIVATE KEY-----\n"

ADMIN_SESSION_SECRET=EXAMPLE_ADMIN_SESSION_SECRET_KEY_MIN_32_CHARS
PYTHON_SERVICE_SECRET=EXAMPLE_PYTHON_SERVICE_SECRET
