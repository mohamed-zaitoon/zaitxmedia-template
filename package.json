{
  "name": "zaitxmedia",
  "version": "1.0.0",
  "private": true,
  "scripts": {
    "dev": "node node_modules/next/dist/bin/next dev",
    "build": "node node_modules/next/dist/bin/next build",
    "start": "node node_modules/next/dist/bin/next start",
    "provider": "node provider-server/server.js",
    "provider:check": "node --check provider-server/server.js",
    "worker:check": "npx tsc --noEmit -p worker/tsconfig.json",
    "worker:deploy": "npx wrangler deploy --config wrangler.jsonc",
    "typecheck": "tsc --noEmit",
    "test": "tsx --test lib/**/*.test.ts worker/test/*.test.ts",
    "test:payments": "tsx --test lib/**/*.test.ts",
    "test:security": "tsx --test worker/test/*.test.ts",
    "db:migrate:local": "wrangler d1 migrations apply DB --local --config wrangler.jsonc",
    "db:migrate:remote": "wrangler d1 migrations apply DB --remote --config wrangler.jsonc",
    "financial:migrate": "tsx scripts/migrate-financial-v2.ts",
    "financial:migrate:apply": "tsx scripts/migrate-financial-v2.ts --apply",
    "generate:favicons": "node scripts/generate-favicons.js",
    "deploy:vercel": "npx vercel --prod",
    "app:linux:run": "./scripts/zaitx-admin-linux-bin",
    "app:linux:dev": "cd apps/linux-admin && npm start",
    "app:linux:package": "cd apps/linux-admin && npx electron-builder --linux AppImage"
  },
  "dependencies": {
    "@better-auth/infra": "^0.3.7",
    "@capacitor/android": "^8.5.0",
    "@capacitor/cli": "^8.5.0",
    "@capacitor/core": "^8.5.0",
    "@clerk/localizations": "^4.13.7",
    "@clerk/nextjs": "^7.7.8",
    "@clerk/themes": "^2.4.57",
    "@hookform/resolvers": "^5.4.2",
    "@next/swc-linux-x64-gnu": "^15.5.21",
    "@next/swc-linux-x64-musl": "^15.5.21",
    "@protobufjs/pool": "^1.1.0",
    "@radix-ui/react-context": "^1.2.2",
    "@simplewebauthn/browser": "^13.3.0",
    "@simplewebauthn/server": "^13.3.2",
    "@tanstack/react-query": "^5.101.4",
    "better-auth": "^1.6.24",
    "better-sqlite3": "^12.11.1",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "dotenv": "^17.4.2",
    "drizzle-orm": "^0.45.2",
    "embla-carousel-react": "^8.6.0",
    "fazercards": "^0.1.0",
    "firebase": "^12.17.1",
    "firebase-admin": "^13.10.0",
    "framer-motion": "^13.1.0",
    "lucide-react": "^1.33.0",
    "next": "^16.3.1",
    "next-themes": "^0.4.6",
    "node-fetch": "^3.3.2",
    "radix-ui": "^1.6.7",
    "react": "^19.2.8",
    "react-countdown": "^2.3.6",
    "react-dom": "^19.2.8",
    "react-hook-form": "^7.83.0",
    "react-hot-toast": "^2.6.0",
    "react-icons": "^5.7.0",
    "react-onesignal": "^3.5.6",
    "sonner": "^2.0.8",
    "sweetalert2": "^11.26.25",
    "tailwind-merge": "^3.6.0",
    "vaul": "^1.1.2",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^5.20260723.1",
    "@opennextjs/cloudflare": "^1.20.2",
    "@tailwindcss/postcss": "^4.3.2",
    "@types/better-sqlite3": "^7.6.13",
    "@types/node": "^22.15.21",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "postcss": "^8.5.19",
    "tailwindcss": "^4.3.3",
    "tsx": "^4.23.1",
    "typescript": "^7.0.2",
    "wrangler": "^4.113.0"
  }
}
